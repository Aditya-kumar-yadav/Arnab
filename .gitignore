# ==============================================================================
# SECRETS & ENVIRONMENT CONFIGURATION (CRITICAL: NEVER COMMIT TO PUBLIC GIT)
# ==============================================================================
.env
.env.*
*.env
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.local
frontend/.env.*
!frontend/.env.example

# Credentials, Keys & Certificates
*.pem
*.key
*.cert
*.crt
id_rsa*
*.pfx

# ==============================================================================
# DATABASES & PERSISTENT STORAGE
# ==============================================================================
*.sqlite
*.sqlite3
*.db
pathfinder.db
backend/pathfinder.db
backend/*.db

# ==============================================================================
# UPLOADS & USER FILES (PROTECT PRIVACY IN PUBLIC REPOSITORIES)
# ==============================================================================
backend/uploads/resumes/*
!backend/uploads/resumes/.gitkeep
!backend/uploads/resumes/aditya_kumar_yadav_resume.pdf
!backend/uploads/resumes/manish_resume.pdf

# ==============================================================================
# PYTHON ARTIFACTS
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
venv/
.venv/
env/

# ==============================================================================
# NODE.JS & NEXT.JS BUILD ARTIFACTS
# ==============================================================================
node_modules/
.next/
out/
build/
dist/
frontend/.next/
frontend/node_modules/
*.tsbuildinfo
next-env.d.ts

# ==============================================================================
# LOGS & SYSTEM
# ==============================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
