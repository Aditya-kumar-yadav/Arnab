# PATHFINDER AI - Backend Environment Variables
PROJECT_NAME="PATHFINDER AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration
# Default: Local SQLite (zero-config, high-speed dev and demo)
DATABASE_URL="sqlite:///./pathfinder.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/pathfinder_db"

# Clerk Authentication (Get these from https://dashboard.clerk.com)
CLERK_SECRET_KEY="sk_test_placeholder_key"
CLERK_PUBLISHABLE_KEY="pk_test_placeholder_key"
CLERK_WEBHOOK_SECRET="whsec_placeholder_secret"

# JWT Secret (for session signing & API tokens)
JWT_SECRET="super-secure-pathfinder-secret-key-change-in-prod-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

