# ==============================================================================
# PATHFINDER AI - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# For Render deployment, configure these environment variables in your Render Dashboard.
# ==============================================================================

PROJECT_NAME="PATHFINDER AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Local Development / Ephemeral Free Tier on Render (SQLite):
DATABASE_URL="sqlite:///./pathfinder.db"
# Managed PostgreSQL on Render:
# DATABASE_URL="postgresql://user:password@hostname:5432/pathfinder_db"

# ------------------------------------------------------------------------------
# JWT & Session Security
# ------------------------------------------------------------------------------
# Replace with a cryptographically secure random 256-bit key in production.
# On Render Blueprint, this is automatically generated.
JWT_SECRET="generate-a-secure-random-32-byte-hex-string-for-prod-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# Clerk Authentication (Get these from https://dashboard.clerk.com)
# ------------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY="pk_test_placeholder_key"
CLERK_SECRET_KEY="sk_test_placeholder_key"
CLERK_WEBHOOK_SECRET="whsec_placeholder_secret"

# ------------------------------------------------------------------------------
# CORS & Allowed Frontend Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend URLs
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
FRONTEND_URL="http://localhost:3000"
